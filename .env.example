# Public site form (server only — no NEXT_PUBLIC_ prefix)
WEB3FORMS_ACCESS_KEY=

# Supabase. Use these names on Vercel as Sensitive/Secret, not NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hub allowlist
HUB_ALLOWED_EMAIL=cam.r.brown82@gmail.com
# Local only. On Vercel Production set SITE_URL=https://wwwdigisol.com
SITE_URL=http://localhost:3000

# Optional: require this header (x-hub-secret) for third-party webhooks into /api/leads
HUB_INGEST_SECRET=

# Resend. The From domain must be verified at https://resend.com/domains
# or sends are limited to the email on your Resend account.
RESEND_API_KEY=
RESEND_FROM=DigiSol <hello@wwwdigisol.com>
RESEND_REPLY_TO=cam.r.brown82@gmail.com
HUB_PHYSICAL_ADDRESS=Alberta, Canada
UNSUBSCRIBE_SECRET=

# OpenAI (server only)
OPENAI_API_KEY=
# dall-e-3 works on most accounts. gpt-image-1 needs a verified org.
OPENAI_IMAGE_MODEL=dall-e-3

# Google Ads (public tag ID only — not the account password)
# From Google Ads: Goals > Conversions > Tag setup. Looks like AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Optional conversion label from the same conversion action
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

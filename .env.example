# Public site (already in use)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Supabase (Auth, Postgres, Storage). Never expose the service role to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hub allowlist (magic link + middleware)
HUB_ALLOWED_EMAIL=cam.r.brown82@gmail.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: require this header (x-hub-secret) for third-party webhooks into /api/leads
HUB_INGEST_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM=DigiSol <hello@wwwdigisol.com>
HUB_PHYSICAL_ADDRESS=Alberta, Canada
UNSUBSCRIBE_SECRET=

# OpenAI (server only) — image generation for posters
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=dall-e-3

# Inngest (workflows). Run `npx inngest-cli@latest dev` locally.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

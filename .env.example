# Public site form (server only — no NEXT_PUBLIC_ prefix)
WEB3FORMS_ACCESS_KEY=

# Meta (Facebook) Pixel — Events Manager → Data sources → your Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
# Optional temporary test code only while verifying Events Manager
# NEXT_PUBLIC_META_TEST_EVENT_CODE=

# Meta Conversions API + Ads Insights (system user token preferred)
# META_CAPI_ACCESS_TOKEN needs ads_management (CAPI) and/or ads_read (Insights)
META_CAPI_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# act_123… also accepted as 123…
# Falls back to META_PAGE_ACCESS_TOKEN when CAPI token is unset

# Supabase. Use these names on Vercel as Sensitive/Secret, not NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Needed for schema-ensure helpers (agent logs, wallets, digisol_daily_usage)
POSTGRES_URL=

# Hub allowlist — owner-only password login (no magic link / OTP).
# Always includes digisol2026@yahoo.com (+ legacy personal inbox in code).
# Extra exact emails only (no wildcards).
HUB_ALLOWED_EMAIL=digisol2026@yahoo.com,cam.r.brown82@gmail.com
# Optional but recommended on Vercel Production.
# When UNSET: /hub/login is reachable (password still owner-only).
# When SET: strangers get 404; unlock YOUR PC once with:
#   https://wwwdigisol.com/hub/login?gate=YOUR_LONG_SECRET
HUB_GATE_SECRET=
# Optional: comma-separated public IPs that skip the gate cookie (your home/office).
HUB_ALLOWED_IPS=
# Local only. On Vercel Production set SITE_URL=https://wwwdigisol.com
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: require this header (x-hub-secret) for third-party webhooks into /api/leads
# Required in production — Origin-based bypass was removed for security.
HUB_INGEST_SECRET=

# Resend. The From domain must be verified at https://resend.com/domains
# or sends are limited to the email on your Resend account.
# From MUST be on wwwdigisol.com (Yahoo cannot be a From address in Resend).
RESEND_API_KEY=
RESEND_FROM=DigiSol <hello@wwwdigisol.com>
RESEND_REPLY_TO=digisol2026@yahoo.com
# Resend webhook signing secret (whsec_…) — required for /api/webhooks/resend
# Create at Resend → Webhooks → URL https://wwwdigisol.com/api/webhooks/resend
RESEND_WEBHOOK_SECRET=
HUB_PHYSICAL_ADDRESS=Alberta, Canada
UNSUBSCRIBE_SECRET=

# OpenAI (server only) — required for Kaylev homepage chat + Hub AI
OPENAI_API_KEY=
# dall-e-3 works on most accounts. gpt-image-1 needs a verified org.
OPENAI_IMAGE_MODEL=dall-e-3
# Growth phase: DigiSol house budgets are unrestricted by default.
# Set to 1 later to restore hard daily audit/email/token caps.
# DIGISOL_ENFORCE_BUDGETS=1

# Stripe (live on Vercel Production once marketplace is connected)
# Checkout uses STRIPE_SECRET_KEY server-side. Use sk_live_… in production.
STRIPE_SECRET_KEY=
# Optional publishable key if you add client Stripe.js later
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional: pin Alberta GST tax rate id (otherwise auto-created)
# STRIPE_TAX_RATE_GST_AB=

# Cron auth for /api/cron/* (prospect-audit, dispatch, social-dispatch, resend-sync).
CRON_SECRET=

# Meta Graph — Facebook PAGE (not personal profile) + Instagram Business
# App ID / App Secret are for Meta Developer console only — DigiSol does not read them.
# Get Page ID: Page → About → Page ID (or Meta Business Suite)
META_PAGE_ID=1383983421458063
# Long-lived Page access token (pages_manage_posts, pages_read_engagement, …)
META_PAGE_ACCESS_TOKEN=
# Instagram Graph business account id (linked to the Page) — required for IG posts/insights
# Find it: Graph API Explorer → GET /me/accounts?fields=instagram_business_account
# (needs instagram_basic; IG must be linked to the Page in Business Suite)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Optional public overrides if vanity URLs change
# NEXT_PUBLIC_DIGISOL_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61594718912547
# NEXT_PUBLIC_DIGISOL_INSTAGRAM_HANDLE=digi.sol20269

# LinkedIn Marketing UGC (person or organization URN, e.g. urn:li:person:…)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# Google Ads (public tag ID only — not the account password)
# From Google Ads: Goals > Conversions > Tag setup. Looks like AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18436977006
# Optional classic label (AW-ID/label send_to). Prefer when Google shows it.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
# Named conversion event from Ads “add code” screen (page load on /confirmation)
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_EVENT=ads_conversion_Book_appointment_1

# GA4 Data API — pulls DigiSol site stats into Hub → Analytics
# Property ID is numeric (Admin → Property settings), not G-XXXXXXXX
GA4_PROPERTY_ID=
# Service account with Viewer on the DigiSol GA4 property
GA4_CLIENT_EMAIL=
# Paste the private_key from the JSON key; use \n for newlines in Vercel
GA4_PRIVATE_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
